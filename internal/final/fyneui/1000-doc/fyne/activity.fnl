// Activity

/*
An animated busy indicator.
Call start to run it and stop to halt it.
Also has Canvas.visible and Canvas.refresh.
*/
:doc Activity

/*
Start the animation.
( -- )
*/
:doc Activity#start

/*
Stop the animation.
( -- )
*/
:doc Activity#stop

/*
Create an Activity indicator.
( -- activity:Activity )
*/
:doc Activity#new
