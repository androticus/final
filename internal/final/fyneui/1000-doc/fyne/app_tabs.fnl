// AppTabs

/*
A row of titled tabs, each with its own content.
Also has Canvas.visible and Canvas.refresh.
*/
:doc AppTabs

/*
Index of the selected tab, starting at 0.
*/
:doc AppTabs#selectedIndex

/*
Add a tab with the given title and content.
( title:s content -- )
*/
:doc AppTabs#append

/*
Create an empty AppTabs.
( -- tabs:AppTabs )
*/
:doc AppTabs#new
