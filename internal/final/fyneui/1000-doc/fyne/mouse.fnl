// MouseEvent and ScrollEvent

/*
A mouse press, release, or hover event from CanvasImage.
*/
:doc MouseEvent

/*
Primary mouse button (left).
*/
:doc MouseEvent#btnPrimary

/*
Secondary mouse button (right).
*/
:doc MouseEvent#btnSecondary

/*
Tertiary mouse button (middle).
*/
:doc MouseEvent#btnTertiary

/*
Shift modifier bit.
*/
:doc MouseEvent#keyShift

/*
Control modifier bit.
*/
:doc MouseEvent#keyControl

/*
Alt modifier bit.
*/
:doc MouseEvent#keyAlt

/*
Super / Command modifier bit.
*/
:doc MouseEvent#keySuper

/*
Pointer position in the widget.
*/
:doc MouseEvent#position

/*
Pointer position in the window.
*/
:doc MouseEvent#absolutePosition

/*
Pressed mouse button.
*/
:doc MouseEvent#button

/*
Held modifier keys.
*/
:doc MouseEvent#modifier

/*
A mouse-wheel event from CanvasImage.
*/
:doc ScrollEvent

/*
Pointer position in the widget.
*/
:doc ScrollEvent#position

/*
Pointer position in the window.
*/
:doc ScrollEvent#absolutePosition

/*
Scroll delta.
*/
:doc ScrollEvent#scrolled
