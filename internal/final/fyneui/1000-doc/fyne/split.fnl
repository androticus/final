// Split

/*
Two panes with a movable divider.
Also has Canvas.visible and Canvas.refresh.
*/
:doc Split

/*
Set the divider position from 0 to 1.
( offset:f -- )
*/
:doc Split#setOffset

/*
Create a horizontal Split.
( leading trailing -- split:Split )
*/
:doc Split#newH

/*
Create a vertical Split.
( top bottom -- split:Split )
*/
:doc Split#newV
